# ============================================================
# X-Road Metrics — variables de despliegue Docker
# Copiar a ".env" y rellenar. NUNCA subir el .env real a Git.
# ============================================================

# --- Instancia X-Road ---
# Código de instancia EXACTO como aparece en la configuración global (p. ej. PROD, TEST, CU).
XROAD_INSTANCE=DEV
# El mismo código en minúsculas (se usa en nombres de BD/usuarios de PostgreSQL).
INSTANCE_LOWER=dev

# --- Plataforma X-Road (solo módulos Collector y Anonymizer) ---
# Host del Central Server (API internalconf). En el piloto Docker oficial era el
# servicio "cs" de la pila de desarrollo xrd-dev-stack.
CENTRAL_SERVER_HOST=cs
# Security Server que actúa como puerta de entrada (cliente de monitoreo).
# Formato host[:puerto] alcanzable desde los contenedores (oficial: ss0:8080).
SECURITY_SERVER_HOST=ss0:8080
# Identidad del subsistema cliente de monitoreo registrado en X-Road.
MONITORING_MEMBER_CLASS=COM
MONITORING_MEMBER_CODE=1234
MONITORING_SUBSYSTEM_CODE=metrics

# --- MongoDB (zona privada) ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root_pw
# Contraseñas por módulo. generar-init.sh las inyecta en los scripts de
# inicialización ANTES del primer arranque. En el piloto pueden dejarse las
# de desarrollo; en producción son obligatorias y distintas.
MONGO_COLLECTOR_PASSWORD=collectordevpw
MONGO_CORRECTOR_PASSWORD=correctordevpw
MONGO_ANONYMIZER_PASSWORD=anonymizerdevpw
MONGO_REPORTS_PASSWORD=reportsdevpw
MONGO_OPENDATA_COLLECTOR_PASSWORD=opendatacollectordevpw

# --- PostgreSQL (zona pública) ---
POSTGRES_ADMIN_USER=xroadmetrics
POSTGRES_ADMIN_PASSWORD=postgres_pw
PG_ANONYMIZER_PASSWORD=anonymizer_devsecret
PG_OPENDATA_PASSWORD=opendata_devsecret
PG_NETWORKING_PASSWORD=networking_devsecret
# Solo despliegue dividido (compose.privado): host del PostgreSQL remoto
# (IP/host del servidor de la zona pública en la VLAN correspondiente).
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
# Dirección local a la que se ata el puerto 5432 en el host público.
# 127.0.0.1 = solo local. En despliegue dividido poner la IP de la VLAN que
# mira a la zona privada y filtrar por firewall SOLO desde el Anonymizer.
POSTGRES_BIND_IP=127.0.0.1

# --- Publicación web (zona pública) ---
# Se recomienda 127.0.0.1 y publicar hacia fuera con un proxy inverso HTTPS
# del propio host (Apache/Nginx con el certificado del operador).
OPENDATA_BIND_IP=127.0.0.1
OPENDATA_PORT=8000
# Días de retardo de publicación de Open Data (Estonia usa 10; 0 = sin retardo).
OPENDATA_DELAY_DAYS=0
# Clave secreta de la aplicación web de Opendata. Obligatorio cambiarla.
DJANGO_SECRET_KEY=secret
NETWORKING_BIND_IP=127.0.0.1
NETWORKING_PORT=8001

# --- Reports ---
REPORTS_EMAIL_SENDER=test@x-road.global
REPORTS_SMTP_HOST=localhost
